# ============================================================
# CSV UTF-8 转换器 - Git 忽略规则
# ============================================================

# ---------- Rust / Tauri 编译产物（构建时生成，勿提交） ----------
/target/
/src-tauri/target/
**/*.rs.bk

# ---------- 由 tauri-build 自动生成 ----------
# 说明：src-tauri/gen/schemas 每次构建都会重新生成（Tauri 官方模板默认忽略）。
# 当前磁盘上保留了这些文件；如需从版本库排除，取消下一行注释即可。
# /src-tauri/gen/schemas/

# ---------- 预置 DuckDB 扩展二进制（7 个，约 196 MB） ----------
# 说明：离线 SQL 依赖这 7 个扩展文件，由 Git LFS 托管（规则见 .gitattributes），
# 必须随仓库分发 —— 打包时经 tauri.conf.json 的 bundle.resources 进入安装包。
# 不要取消下面这行的注释，否则克隆者拿不到扩展、离线 SQL 会静默退化为联网 INSTALL。
# 如需按需重新下载，见 src-tauri/tests/install_all.rs。
# /src-tauri/tools/duckdb-extensions/

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/

# ---------- WorkBuddy 工作目录（项目数据与记忆，勿提交） ----------
.workbuddy-ai/

# ---------- 测试数据（大文件，勿提交） ----------
/test_bigfile.csv
/testdata/

# ---------- SQL 转码缓存（与数据文件同目录，运行时生成） ----------
# 命名规则：utf8_<原文件名>，由 SQL 面板自动生成，勿提交。
utf8_*
